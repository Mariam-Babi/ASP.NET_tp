@model IEnumerable<CinemaManager.Models.Cinema.Producer>

<h2>Producteurs et leurs Films</h2>

<table class="table">
    <thead>
        <tr>
            <th>Nom du producteur</th>
            <th>Nationalité</th>
            <th>Titre du film</th>
            <th>Genre</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var producer in Model)
        {
            foreach (var movie in producer.Movies)
            {
                <tr>
                    <td>@producer.Name</td>
                    <td>@producer.Nationality</td>
                    <td>@movie.Title</td>
                    <td>@movie.Genre</td>
                </tr>
            }
        }
    </tbody>
</table>
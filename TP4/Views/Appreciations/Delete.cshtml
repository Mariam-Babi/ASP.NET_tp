@model Hotellerie_X.Models.HotellerieModel.Appreciation

@{
    ViewData["Title"] = "Supprimer l'Appréciation";
}

<h1>Supprimer l'Appréciation</h1>

<h3>Êtes-vous sûr de vouloir supprimer cette appréciation ?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.NomPers)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.NomPers)</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Commentaire)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Commentaire)</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Note)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Note)</dd>
        <dt class="col-sm-2">Hôtel</dt>
        <dd class="col-sm-10">@Model.Hotel?.Nom</dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Supprimer" class="btn btn-danger" />
        <a asp-action="Index">Annuler</a>
    </form>
</div>

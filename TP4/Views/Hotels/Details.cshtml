@model Hotellerie_X.Models.HotellerieModel.Hotel

@{
    ViewData["Title"] = "Détails de l'Hôtel";
}

<h1>Détails de l'Hôtel</h1>

<div>
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Nom)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Nom)</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Etoiles)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Etoiles)</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Ville)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Ville)</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.SiteWeb)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.SiteWeb)</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Tel)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Tel)</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Pays)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Pays)</dd>
    </dl>
</div>

<h3>Appréciations</h3>
@if (Model.Appreciations != null && Model.Appreciations.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Nom Personne</th>
                <th>Commentaire</th>
                <th>Note</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var appr in Model.Appreciations)
            {
                <tr>
                    <td>@appr.NomPers</td>
                    <td>@appr.Commentaire</td>
                    <td>@appr.Note</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>Aucune appréciation pour cet hôtel.</p>
}

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id">Modifier</a> |
    <a asp-action="Index">Retour à la liste</a>
</div>

@model IEnumerable<CinemaManager.Models.Cinema.Movie>
@{
    ViewData["Title"] = "Films et leurs Producteurs";
}

<h2>Films et leurs Producteurs</h2>
<p><a asp-action="Index">Retour à la liste</a></p>

<table class="table">
    <thead>
        <tr>
            <th>Titre du Film</th>
            <th>Genre</th>
            <th>Nom du Producteur</th>
            <th>Nationalité du Producteur</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Title</td>
                <td>@item.Genre</td>
                <td>@item.Producer?.Name</td>
                <td>@item.Producer?.Nationality</td>
            </tr>
        }
    </tbody>
</table>

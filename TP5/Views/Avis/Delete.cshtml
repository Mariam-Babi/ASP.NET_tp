@model RestoManager_X.Models.RestosModel.Avis

@{
    ViewData["Title"] = "Supprimer l'Avis";
}

<h1>Supprimer l'Avis</h1>
<h3>Êtes-vous sûr de vouloir supprimer cet avis ?</h3>

<dl class="row">
    <dt class="col-sm-2">Code Avis</dt>
    <dd class="col-sm-10">@Model.CodeAvis</dd>
    <dt class="col-sm-2">Nom Personne</dt>
    <dd class="col-sm-10">@Model.NomPersonne</dd>
    <dt class="col-sm-2">Note</dt>
    <dd class="col-sm-10">@Model.Note</dd>
    <dt class="col-sm-2">Commentaire</dt>
    <dd class="col-sm-10">@Model.Commentaire</dd>
    <dt class="col-sm-2">Restaurant</dt>
    <dd class="col-sm-10">@Model.LeResto?.NomResto</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="CodeAvis" />
    <input type="submit" value="Supprimer" class="btn btn-danger" />
    <a asp-action="Index">Annuler</a>
</form>

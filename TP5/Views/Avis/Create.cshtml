@model RestoManager_X.Models.RestosModel.Avis

@{
    ViewData["Title"] = "Ajouter un Avis";
}

<h1>Ajouter un Avis</h1>

<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="CodeAvis" class="control-label">Code Avis</label>
                <input asp-for="CodeAvis" class="form-control" />
                <span asp-validation-for="CodeAvis" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="NomPersonne" class="control-label">Nom Personne</label>
                <input asp-for="NomPersonne" class="form-control" />
                <span asp-validation-for="NomPersonne" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Note" class="control-label">Note (1-5)</label>
                <input asp-for="Note" class="form-control" />
                <span asp-validation-for="Note" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Commentaire" class="control-label">Commentaire</label>
                <textarea asp-for="Commentaire" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Commentaire" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="NumResto" class="control-label">Restaurant</label>
                <select asp-for="NumResto" class="form-control" asp-items="ViewBag.NumResto"></select>
                <span asp-validation-for="NumResto" class="text-danger"></span>
            </div>
            <div class="form-group mt-2">
                <input type="submit" value="Créer" class="btn btn-primary" />
                <a asp-action="Index">Retour à la liste</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

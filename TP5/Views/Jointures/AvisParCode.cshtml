@model IEnumerable<RestoManager_X.Models.RestosModel.Avis>

@{
    ViewData["Title"] = "Avis par Code Restaurant";
}

<h1>Avis pour un Restaurant</h1>
<p><em>Jointure via requête LINQ — filtrage par code restaurant</em></p>

<div class="mb-3">
    <form method="get" asp-action="AvisParCode">
        <div class="input-group" style="max-width:400px;">
            <select name="code" class="form-control">
                <option value="">-- Choisir un restaurant --</option>
                @if (ViewBag.Restaurants != null)
                {
                    foreach (var r in ViewBag.Restaurants)
                    {
                        <option value="@r.CodeResto" @(ViewBag.CodeResto != null && ViewBag.CodeResto == r.CodeResto ? "selected" : "")>
                            [@r.CodeResto] @r.NomResto
                        </option>
                    }
                }
            </select>
            <button type="submit" class="btn btn-primary">Filtrer</button>
        </div>
    </form>
</div>

@if (ViewBag.CodeResto != null)
{
    <h3>Avis pour : <em>@ViewBag.RestaurantNom</em></h3>

    @if (Model.Any())
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Nom Personne</th>
                    <th>Note</th>
                    <th>Commentaire</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var avis in Model)
                {
                    <tr>
                        <td>@avis.NomPersonne</td>
                        <td>@avis.Note / 5</td>
                        <td>@avis.Commentaire</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted">Aucun avis trouvé pour ce restaurant.</p>
    }
}

<p><a asp-controller="Proprietaires" asp-action="Index">Retour à l'accueil</a></p>

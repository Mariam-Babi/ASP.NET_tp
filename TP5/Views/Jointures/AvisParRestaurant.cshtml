@model IEnumerable<RestoManager_X.Models.RestosModel.Restaurant>

@{
    ViewData["Title"] = "Avis par Restaurant";
}

<h1>Avis par Restaurant</h1>
<p><em>Jointure via propriétés de navigation</em></p>
<p><a asp-controller="Proprietaires" asp-action="Index">Retour à l'accueil</a></p>

@foreach (var restaurant in Model)
{
    <div class="card mb-3">
        <div class="card-header">
            <strong>@restaurant.NomResto</strong> — @restaurant.Ville — Spécialité : @restaurant.Specialite
        </div>
        <div class="card-body">
            @if (restaurant.LesAvis != null && restaurant.LesAvis.Any())
            {
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Personne</th>
                            <th>Note</th>
                            <th>Commentaire</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var avis in restaurant.LesAvis)
                        {
                            <tr>
                                <td>@avis.NomPersonne</td>
                                <td>@avis.Note / 5</td>
                                <td>@avis.Commentaire</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">Aucun avis pour ce restaurant.</p>
            }
        </div>
    </div>
}

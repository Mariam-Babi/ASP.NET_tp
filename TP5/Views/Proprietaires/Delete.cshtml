@model RestoManager_X.Models.RestosModel.Proprietaire

@{
    ViewData["Title"] = "Supprimer le Propriétaire";
}

<h1>Supprimer le Propriétaire</h1>
<h3>Êtes-vous sûr de vouloir supprimer ce propriétaire ?</h3>

<dl class="row">
    <dt class="col-sm-2">Numéro</dt>
    <dd class="col-sm-10">@Model.Numero</dd>
    <dt class="col-sm-2">Nom</dt>
    <dd class="col-sm-10">@Model.Nom</dd>
    <dt class="col-sm-2">Email</dt>
    <dd class="col-sm-10">@Model.Email</dd>
    <dt class="col-sm-2">GSM</dt>
    <dd class="col-sm-10">@Model.Gsm</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="Numero" />
    <input type="submit" value="Supprimer" class="btn btn-danger" />
    <a asp-action="Index">Annuler</a>
</form>

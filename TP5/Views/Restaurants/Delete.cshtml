@model RestoManager_X.Models.RestosModel.Restaurant

@{
    ViewData["Title"] = "Supprimer le Restaurant";
}

<h1>Supprimer le Restaurant</h1>
<h3>Êtes-vous sûr de vouloir supprimer ce restaurant ?</h3>

<dl class="row">
    <dt class="col-sm-2">Code</dt>
    <dd class="col-sm-10">@Model.CodeResto</dd>
    <dt class="col-sm-2">Nom</dt>
    <dd class="col-sm-10">@Model.NomResto</dd>
    <dt class="col-sm-2">Spécialité</dt>
    <dd class="col-sm-10">@Model.Specialite</dd>
    <dt class="col-sm-2">Ville</dt>
    <dd class="col-sm-10">@Model.Ville</dd>
    <dt class="col-sm-2">Propriétaire</dt>
    <dd class="col-sm-10">@Model.LeProprio?.Nom</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="CodeResto" />
    <input type="submit" value="Supprimer" class="btn btn-danger" />
    <a asp-action="Index">Annuler</a>
</form>
